# Supabase — use the public anon key only. Never put service_role in this file.
# Create a project at https://supabase.com, run supabase/migrations in order, then fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL used for canonical URLs, sitemap, JSON-LD and email links.
NEXT_PUBLIC_SITE_URL=https://all-1-2026.vercel.app

# Quote emails — server-side only, never exposed to the browser.
# Without RESEND_API_KEY the /preventivo request is still stored in Supabase,
# but no email is sent and the form says so honestly.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. onboarding@resend.dev works only
# for test sends to the Resend account owner's address.
QUOTE_FROM_EMAIL="CircularLink <onboarding@resend.dev>"
QUOTE_NOTIFICATION_EMAIL=hello@circularlink.app

# Gemini AI for chatbot — get your key from https://aistudio.google.com/app/apikey
# Without GEMINI_API_KEY the chatbot will show an error message.
GEMINI_API_KEY=
